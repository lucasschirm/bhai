{
	"typescript": {
		"command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/typescript-language-server",
		"args": ["--stdio"],
		"transport": "stdio",
		"workspaceFolder": "${CLAUDE_PROJECT_DIR}",
		"extensionToLanguage": {
			".ts": "typescript",
			".mts": "typescript",
			".cts": "typescript",
			".tsx": "typescriptreact",
			".js": "javascript",
			".mjs": "javascript",
			".cjs": "javascript",
			".jsx": "javascriptreact"
		},
		"initializationOptions": {
			"preferences": {
				"includeInlayParameterNameHints": "none",
				"importModuleSpecifierPreference": "shortest"
			}
		}
	}
}
